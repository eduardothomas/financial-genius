{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"],
      "cache": false
    },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
