DATABASE_URL=postgres://postgres@localhost:5432/fg

# Supabase Auth: la API verifica los tokens con las claves públicas del proyecto (JWKS)
SUPABASE_URL=
# Solo si el proyecto todavía firma con el JWT secret heredado (HS256)
AUTH_JWT_SECRET=

# Desarrollo local: aceptar x-dev-user (prohibido en producción)
FG_DEV_USERS=1

# Chat del Genio
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Orígenes de la app web, separados por coma
CORS_ORIGINS=http://localhost:8081
