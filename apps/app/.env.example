# URL de la API (services/api)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase Auth (producción). Si se dejan vacías, la app entra en modo de desarrollo (solo correo).
# Están pensadas para ser públicas: la anon/publishable key no da acceso a datos sin un usuario.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
